#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        diode-direction = "col2row";

        col-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>,
                    <&gpio0 6 GPIO_ACTIVE_HIGH>;

        row-gpios = <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };

    chosen {
        zmk,kscan = &kscan0;
    };


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q   &kp W
                &kp A   &kp S
            >;
        };

        // 左
        layer_1 {
            bindings = <
                &kp 1 &none
                &none &none
            >;
        };

        // 上
        layer_2 {
            bindings = <
                &kp 2 &none
                &none &none
            >;
        };

        // 右
        layer_3 {
            bindings = <
                &kp 3 &none
                &none &none
            >;
        };

        // 下
        layer_4 {
            bindings = <
                &kp 4 &none
                &none &none
            >;
        };
    };
};

