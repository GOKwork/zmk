#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    /* ここ：全部GPIOを直接読むスキャナ定義（今までと同じ） */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";

        /* 順番 = キーのインデックス（0〜7） */
        input-gpios = <
            &gpio0 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)   /* 0: Q */
            &gpio0 8  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)   /* 1: W */
            &gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)   /* 2: A */
            &gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)   /* 3: S */
            &gpio0 2  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)   /* 4: 左スティック */
            &gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)   /* 5: 上スティック */
            &gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)   /* 6: 右スティック */
            &gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)   /* 7: 下スティック */
        >;
    };

    chosen {
        zmk,kscan = &kscan0;
    };

    keymap {
        compatible = "zmk,keymap";

        /* レイヤー0：通常レイヤー。QWAS + 方向でレイヤー切り替え */
        default_layer {
            bindings = <
                &kp Q   &kp W
                &kp A   &kp S

                &mo 1   &mo 2   /* 4: 左 → L1, 5: 上 → L2 */
                &mo 3   &mo 4   /* 6: 右 → L3, 7: 下 → L4 */
            >;
        };

        /* レイヤー1：左レイヤー（Qの位置だけ1にしてテストしやすく） */
        layer_1 {
            bindings = <
                &kp N1  &trans
                &trans  &trans

                &trans  &trans
                &trans  &trans
            >;
        };

        /* レイヤー2：上レイヤー（Qの位置だけ2） */
        layer_2 {
            bindings = <
                &kp N2  &trans
                &trans  &trans

                &trans  &trans
                &trans  &trans
            >;
        };

        /* レイヤー3：右レイヤー（Qの位置だけ3） */
        layer_3 {
            bindings = <
                &kp N3  &trans
                &trans  &trans

                &trans  &trans
                &trans  &trans
            >;
        };

        /* レイヤー4：下レイヤー（Qの位置だけ4） */
        layer_4 {
            bindings = <
                &kp N4  &trans
                &trans  &trans

                &trans  &trans
                &trans  &trans
            >;
        };
    };
};
